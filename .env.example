# Copy this file to .env (next to your config.yaml or in the folder you run ragpick from)
# and fill in the values. .env is git-ignored; never commit real keys.

# --- Azure embeddings (Azure AI Foundry / Azure OpenAI) ---
# Foundry portal -> your project -> Models + endpoints -> your embedding deployment.
# Azure OpenAI deployments (text-embedding-3-large/-small):  https://<resource>.openai.azure.com
# Foundry model inference (Cohere-embed-v3-*, embed-v-4-0):  https://<resource>.services.ai.azure.com
AZURE_EMBEDDING_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_EMBEDDING_API_KEY=<your-key>
# Optional; defaults: 2024-10-21 (api: openai) and 2024-05-01-preview (api: inference)
# AZURE_EMBEDDING_API_VERSION=2024-10-21

# A second Azure resource (for example, Cohere in a different resource), used through
# endpoint_env / api_key_env in config.yaml:
# AZURE_COHERE_ENDPOINT=https://<other-resource>.services.ai.azure.com
# AZURE_COHERE_API_KEY=<other-key>

# --- Goedel Machines (answer generation + judge), OpenAI-compatible API ---
# Free keys (sk-gm-free-...) have prompts retained by the provider; paid keys (sk-gm-paid-...) are zero-retention.
GOEDEL_API_KEY=<your-goedel-key>
# Optional; default https://api.goedelmachines.com/v1
# GOEDEL_BASE_URL=https://api.goedelmachines.com/v1

# --- Claude (only if you set `type: anthropic` for generation or judge) ---
# ANTHROPIC_API_KEY=<your-anthropic-key>
